{
  "schema_name": "DW_CRM_Handoff",
  "schema_version": "0.2.0",
  "mapping_version": "shared-crm-identity-0.2.0",
  "operations": [
    "prepare_company_sync",
    "prepare_contact_sync",
    "reconcile"
  ],
  "input": {
    "tenant_id": "string",
    "campaign_id": "campaign_<tenant>_<stable-key>",
    "canonical_id": "org|person|opportunity_<tenant>_<stable-key>",
    "source_ref": {
      "source_type": "research",
      "source_subtype": "rfq|rfi|prime_landscape|agency|partner|general",
      "campaign_id": "string",
      "record_id": "string",
      "provenance": [
        {
          "url": "string",
          "observed_at": "ISO-8601",
          "source_label": "string"
        }
      ]
    },
    "external_refs": "object",
    "decision_state": "PENDING|GO|NO_GO|CONDITIONAL",
    "posture": "SUB|PRIME|BOTH|MONITOR",
    "contact_context": {
      "organization_canonical_id": "org_<tenant>_<stable-key>",
      "opportunity_canonical_id": "opportunity_<tenant>_<stable-key>|null",
      "source_record_id": "string",
      "role_context": "opportunity_poc|agency_contact|prime_vendor_contact|federal_department_contact|state_department_contact|partner_contact|general"
    },
    "dw_state": "object",
    "campaign_name": "Human-readable campaign label"
  },
  "output": {
    "operation_key": "string",
    "status": "PREPARED|VERIFIED|HOLD|PARTIAL|FAILED",
    "crm_sync": {
      "external_ids": "object",
      "readback_at": "ISO-8601",
      "mapping_version": "string",
      "missing": [
        "string"
      ],
      "conflicts": [
        "string"
      ],
      "campaign_display_name_property": "cintman_campaign_name"
    }
  },
  "guardrails": {
    "no_auto_create_from_discovery": true,
    "no_sync_no_go_or_held": true,
    "ambiguous_identity": "HOLD",
    "preserve_user_edits": true,
    "multiple_contacts_per_organization": true,
    "contact_scope_required": true
  }
}
